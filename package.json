{
  "name": "answerlint-website",
  "version": "0.1.0",
  "description": "AnswerLint — audit websites for AI-generated answers.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "load:test:business": "k6 run load-tests/k6/business-scan.js",
    "load:test:playground": "k6 run load-tests/k6/playground-audit.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.100.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "cheerio": "^1.0.0",
    "inngest": "4.18.1",
    "next": "^15.5.25",
    "next-intl": "^4.14.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.87.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
