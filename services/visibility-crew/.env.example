# Service authentication. Use at least 32 random bytes and keep this identical
# to VISIBILITY_CREW_SIGNING_SECRET in the Next.js deployment.
ANSWERLINT_CREW_SIGNING_SECRET=
ANSWERLINT_CREW_KEY_ID=primary

# Model-agnostic CrewAI/LiteLLM identifier. Examples: openai/gpt-5.6-terra,
# anthropic/claude-sonnet-4-5, gemini/gemini-2.5-flash
ANSWERLINT_CREW_LLM_MODEL=openai/gpt-5.6-terra
ANSWERLINT_CREW_LLM_API_KEY=
ANSWERLINT_CREW_LLM_BASE_URL=
ANSWERLINT_CREW_TEMPERATURE=0
ANSWERLINT_CREW_MAX_TOKENS=5000
ANSWERLINT_CREW_STORAGE_DIR=/tmp/answerlint-crewai

# Runtime security and efficiency limits.
ANSWERLINT_CREW_ALLOWED_HOSTS=localhost,127.0.0.1
ANSWERLINT_CREW_MAX_BODY_BYTES=524288
ANSWERLINT_CREW_MAX_CONCURRENCY=2
ANSWERLINT_CREW_SIGNATURE_TTL_SECONDS=300
ANSWERLINT_CREW_REQUEST_TIMEOUT_SECONDS=90
ANSWERLINT_CREW_LOG_LEVEL=INFO
