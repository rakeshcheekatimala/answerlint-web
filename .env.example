# AI Visibility feature and durable execution
NEXT_PUBLIC_AI_VISIBILITY_ENABLED=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISIBILITY_DAILY_PROVIDER_CALL_LIMIT=280

# Controlled OpenAI web-search measurement. Terra is the quality/cost default;
# use gpt-5.6-luna for cost-sensitive exploratory cohorts.
OPENAI_API_KEY=
OPENAI_VISIBILITY_MODEL=gpt-5.6-terra
OPENAI_VISIBILITY_TIMEOUT_MS=120000
OPENAI_VISIBILITY_MAX_OUTPUT_TOKENS=2000

# Optional bounded CrewAI interpretation service
VISIBILITY_CREW_MODE=best_effort
VISIBILITY_CREW_URL=http://127.0.0.1:8010
VISIBILITY_CREW_SIGNING_SECRET=
VISIBILITY_CREW_KEY_ID=primary
VISIBILITY_CREW_TIMEOUT_MS=90000
