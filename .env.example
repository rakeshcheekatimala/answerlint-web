# AI Visibility feature and durable execution
NEXT_PUBLIC_AI_VISIBILITY_ENABLED=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Controlled OpenAI web-search measurement (use a Responses API model that supports web search)
OPENAI_API_KEY=
OPENAI_VISIBILITY_MODEL=gpt-5-mini
OPENAI_VISIBILITY_TIMEOUT_MS=120000

# Optional bounded CrewAI interpretation service
VISIBILITY_CREW_MODE=best_effort
VISIBILITY_CREW_URL=http://127.0.0.1:8010
VISIBILITY_CREW_SIGNING_SECRET=
VISIBILITY_CREW_KEY_ID=primary
VISIBILITY_CREW_TIMEOUT_MS=90000
